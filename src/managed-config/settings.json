{
  "// MANAGED SETTINGS - src/managed-config/settings.json": "PLACE AT MANAGED LAYER ONLY",
  "// NOT in .vscode/settings.json (agent-writable-untrusted)": "",
  "// Source: ADR-005 D6, SPEC-05 sections 3+4+5, Appendix A": "",
  "// Verified against VS Code 1.124 docs, 2026-06-14 (OI-11-F re-verification)": "",
  "// Item 11 re-verification: see src/managed-config/volatile-key-verification.md": "",
  "//": "",
  "// MANAGED SETTINGS LOCATION (V-04, item 11 must verify for pinned build):": "",
  "// On Linux inside the container: /etc/vscode/settings.json or --settings flag path.": "",
  "// For VS Code enterprise GPO/MDM: platform-specific policy mechanism.": "",
  "// For docker-based deployment: mount this file as read-only at the managed layer path.": "",
  "// CRITICAL: These MUST NOT be placed in .vscode/settings.json (agent-writable-untrusted).": "",
  "// The ChatToolsAutoApprove enterprise policy (V-03) is the load-bearing control; the": "",
  "// settings keys below are the in-settings expression of it. A workspace settings.json": "",
  "// requesting Bypass/Autopilot cannot override managed-level settings.": "",

  "// === SECTION 3: MANAGED POLICY PIN (R-k mitigation, load-bearing) ===": "",

  "// The CVE-2025-53773 YOLO key. Renamed from chat.tools.autoApprove in 1.104; no auto-migration.": "",
  "// Set false at managed level (org-manageable). Re-verified 2026-06-14.": "",
  "chat.tools.global.autoApprove": false,

  "// Pins Default Approvals. Values: 'default' / 'bypass' / 'autopilot'": "",
  "// CRITICAL: VS Code 1.124 defaults this to 'autopilot'. This corrects that.": "",
  "// The ChatToolsAutoApprove=false enterprise policy is the load-bearing vehicle.": "",
  "// Re-verified 2026-06-14. Note: docs show value strings 'Default Approvals'/'Bypass Approvals'/'Autopilot'": "",
  "// but the setting key uses lowercase: 'default'/'bypass'/'autopilot'. Use lowercase.": "",
  "chat.permissions.default": "default",

  "// Experimental; defaults true. Auto-approves npm scripts in package.json/pnpm/yarn.": "",
  "// MUST flip to false. Re-verified 2026-06-14.": "",
  "chat.tools.terminal.autoApproveWorkspaceNpmScripts": false,

  "// NOT off by default (open issue #287073 requests making it off-by-default).": "",
  "// Values: 'off' / 'on' / 'auto'. MUST set 'off' explicitly. Re-verified 2026-06-14.": "",
  "task.allowAutomaticTasks": "off",

  "// Bounded. Current default ~25. Do not raise for convenience. Re-verified 2026-06-14.": "",
  "chat.agent.maxRequests": 25,

  "// === MCP GOVERNANCE SETTINGS (item 12 / ADR-006 D7) ===": "",
  "// These keys are set here (managed layer) per SPEC-06 section 9.": "",
  "// Item 12 re-verified 2026-06-14. See src/scripts/mcp-volatile-key-verification.md.": "",

  "// chat.mcp.discovery.enabled: KEY VERIFIED (code.visualstudio.com/docs/agent-customization/mcp-servers).": "",
  "// DEFAULT UNVERIFIED (docs do not state the default; set false explicitly regardless of default).": "",
  "// SCOPE UNVERIFIED (user/workspace/machine scope not stated; set at managed layer defensively).": "",
  "// Suppresses cross-IDE MCP config autodiscovery from Claude Desktop, Cursor, Windsurf, etc.": "",
  "// Accepts boolean OR granular object (e.g. {\"cursor-global\": false, \"windsurf\": false}).": "",
  "// Per ADR-006 D7 posture: set false regardless of unverified default.": "",
  "chat.mcp.discovery.enabled": false,

  "// chat.mcp.autoStart: KEY VERIFIED as 'autoStart' (camelCase, NOT 'autostart').": "",
  "// Verified 2026-06-14 at code.visualstudio.com/docs/agent-customization/mcp-servers.": "",
  "// Marked Experimental in docs. DEFAULT NOT STATED. Set false explicitly.": "",
  "// Prevents servers from auto-starting when VS Code detects a mcp.json config change.": "",
  "// Critical interaction with SPEC-06 section 8 integrity-check and ADR-006 D7 immutability:": "",
  "// a server must NOT auto-start from an unapproved config change (which the integrity-check": "",
  "// would catch, but belt-and-suspenders requires suppressing auto-start as well).": "",
  "chat.mcp.autoStart": false,

  "// === SECTION 4: TERMINAL AUTO-APPROVE RULESET ===": "",
  "// (extends built-in defaults; do NOT set ignoreDefaultAutoApproveRules: true)": "",
  "// Source: SPEC-05 section 4. Verified against VS Code 1.124 docs, 2026-06-14.": "",
  "chat.tools.terminal.autoApprove": {
    "// === NODE + PYTHON SAFE-INTERIOR ALLOW SET ===": true,
    "pytest": true,
    "ruff": true,
    "mypy": true,
    "tsc": true,
    "eslint": true,
    "prettier": true,
    "jest": true,
    "vitest": true,

    "// npm: allow ci/install/run build/dev/test/lint only": true,
    "// (installs valid ONLY with ADR-002 egress live; see SPEC-05 section 2 prerequisite)": true,
    "/^npm (ci|install|run (build|dev|test|lint))/": true,

    "// uv and poetry (Python; same egress-prerequisite applies)": true,
    "/^uv /": true,
    "/^poetry (install|run)/": true,

    "// Non-pushing git: read and local operations only": true,
    "/^git (status|diff|log|show|add|commit|branch|stash|fetch)/": true,

    "// === BELT-AND-SUSPENDERS DENY SET ===": false,
    "// Deny-wins: a false entry here blocks regardless of what any true entry allows.": false,
    "// These deny entries are redundant with the PreToolUse hook (the real enforcement).": false,

    "rm": false,
    "rmdir": false,
    "del": false,
    "dd": false,
    "mkfs": false,
    "chmod": false,
    "chown": false,
    "kill": false,
    "killall": false,
    "sudo": false,
    "su": false,

    "// Network tools (matchCommandLine:true on deny entries only; bug #270641 does not affect deny).": false,
    "curl": { "approve": false, "matchCommandLine": true },
    "wget": { "approve": false, "matchCommandLine": true },
    "nc": { "approve": false, "matchCommandLine": true },
    "ssh": { "approve": false, "matchCommandLine": true },
    "scp": { "approve": false, "matchCommandLine": true },

    "// Git write operations (belt-and-suspenders; PreToolUse hook forces ask on these)": false,
    "/^git (push|reset --hard|clean|remote)/": false,

    "// npm publish": false,
    "/^npm publish/": false,

    "// Interpreter-with-inline-code class": false,
    "python -c": false,
    "node -e": false,
    "ruby -e": false,
    "perl -e": false,
    "bash -c": false,
    "sh -c": false,
    "eval": false,
    "env": false,
    "xargs": false,
    "find -exec": false
  },

  "// === SECTION 5: FILE-EDIT GATING (CANONICAL - matches canonical boundary-config list) ===": "",
  "// Source: SPEC-05 section 5 + Appendix A. Verified 2026-06-14.": "",
  "// deny-wins: **/* true catch-all is overridden by all false entries below.": "",
  "chat.tools.edits.autoApprove": {
    "**/*": true,
    "**/.vscode/**": false,
    "**/.devcontainer/**": false,
    "**/.git/**": false,
    "**/.github/hooks/**": false,
    "**/.claude/**": false,
    "**/mcp.json": false,
    "**/.env*": false,
    "**/AGENTS.md": false,
    "**/.github/copilot-instructions.md": false,
    "**/*.agent.md": false
  }
}
