# the developer's actual additions in overrides.conf stay local-only.
/config/allowlist.local.d/overrides.conf

# transient per-run test logs/summaries (keep canonical *-results.csv evidence)
tests/*/results/run-*.log
tests/*/results/run-profiles-*.log
tests/*/results/summary-*.txt
tests/*/results/summary-profiles-*.txt

